    <string name="source_fix_map">Report a map error</string>
    <string name="source_driving">Driving routes</string>
    <string name="source_driving_detail">Valhalla on ori.eloque.nz with live closures, from OpenStreetMap data</string>
    <string name="source_walking">Walking and cycling routes</string>
    <string name="source_walking_detail">Valhalla server of FOSSGIS e.V., from OpenStreetMap data, also for driving outside the map of ori.eloque.nz</string>
    <string name="source_roadworks">Roadworks and closures</string>
    <string name="source_roadworks_detail">Open data of road authorities such as Fintraffic, Bison Futé, NDW and Autobahn GmbH, collected on ori.eloque.nz. The link lists each source and its licence.</string>
    <string name="source_reviews">Reviews</string>
    <string name="source_reviews_detail">Mangrove, under CC BY 4.0</string>
    <string name="source_weather">Weather</string>
    <string name="source_weather_detail">Forecasts by Open-Meteo under CC BY 4.0. Radar, clouds, lightning and warnings by LibreWXR under CC BY 4.0, from national weather services.</string>
    <string name="source_layers">Map layers</string>
    <string name="source_layers_detail">Terrain by Mapterhorn, cycling and hiking routes by Waymarked Trails, seamarks by OpenSeaMap. Each layer credits its source on the map.</string>
    <string name="source_tiles">Map tiles</string>
    <string name="source_tiles_detail">OpenFreeMap, built with OpenMapTiles</string>
    <string name="source_places">Place details</string>
    <string name="source_places_detail">Nominatim, from OpenStreetMap data</string>
    <string name="source_nearby">Nearby places</string>
    <string name="source_nearby_detail">Photon by komoot, from OpenStreetMap data</string>
    <string name="source_media">Photos, summaries and travel guides</string>
    <string name="source_media_detail">Wikimedia Commons, Wikidata, Wikipedia and Wikivoyage, under their stated licences</string>
    <string name="source_charging">Charging stations</string>
    <string name="source_charging_detail">Open Charge Map and its data providers</string>
    <string name="source_fuel">Fuel prices</string>
    <string name="source_fuel_detail">France: prix-carburants.gouv.fr under the Licence Ouverte 2.0. Spain: Ministerio para la Transición Ecológica y el Reto Demográfico. Portugal: DGEG, for non-commercial use. Italy: Ministero delle Imprese e del Made in Italy under the IODL 2.0. Mexico: Comisión Nacional de Energía (Fuente: CNE). These five come through the open-fuel-prices server at ori.eloque.nz. Austria: E-Control Spritpreisrechner. Germany: Markttransparenzstelle für Kraftstoffe (MTS-K) via Tankerkönig under CC BY 4.0, served by TankPuls. German prices may only be used to inform consumers and not by the oil industry.</string>
    <string name="api_keys">API keys</string>
    <string name="api_keys_detail">Some services work through a key built into OpenMaps and shared by everyone using it. If one runs into its limits, enter your own free key.</string>
    <string name="privacy">Privacy</string>
    <string name="privacy_detail">There is no account and no tracking. Your location only leaves the device as part of the requests below, each sent only when you use the feature.\n\nTransitous gets searches, transit routes, departures and the area for live vehicles.\n\nori.eloque.nz gets car routes, the map area for roadworks and the area for fuel prices. The Valhalla server of FOSSGIS e.V. gets walking and cycling routes and car routes outside the map of ori.eloque.nz.\n\nNominatim gets the places you open, Photon the area for nearby places, Wikimedia the places you open for photos, summaries and travel guides, and Mangrove the places you open for reviews.\n\nOpen-Meteo gets the places you open and your destination for forecasts. LibreWXR gets them for weather warnings, along with your location, and the map area for the radar.\n\nThe price services of Austria and Germany get the area you search for fuel. Open Charge Map gets the area for charging stations.\n\nMap problems you report become public notes on OpenStreetMap. Map tiles come from OpenFreeMap and the tile servers of the layers you turn on.</string>

